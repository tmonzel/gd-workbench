{
  "name": "gd-creator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "debug:item": "tsx --tsconfig tsconfig.scripts.json scripts/extract-item.ts",
    "extract:lang": "node extract_gd_lang.cjs",
    "extract:database": "node extract_gd_database.cjs",
    "extract:resources": "node extract_gd_resources.cjs",
    "extract:templates": "node extract_gd_templates.cjs",
    "extract:masteries": "tsx --tsconfig tsconfig.scripts.json scripts/extract-masteries.ts",
    "extract:mastery-skills": "tsx --tsconfig tsconfig.scripts.json scripts/extract-mastery-skills.ts",
    "extract:devotions": "tsx --tsconfig tsconfig.scripts.json scripts/extract-devotions.ts",
    "extract:item-sets": "tsx --tsconfig tsconfig.scripts.json scripts/extract-item-sets.ts",
    "extract:affixes": "tsx --tsconfig tsconfig.scripts.json scripts/extract-affixes.ts",
    "extract:relic-bonuses": "tsx --tsconfig tsconfig.scripts.json scripts/extract-relic-bonuses.ts",
    "import:items": "tsx --tsconfig tsconfig.scripts.json scripts/import-items.ts ./data/game/records/items ./public/data/items.json ./data/lang",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/libertinus-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@tabler/icons-react": "^3.47.0",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
